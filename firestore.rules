rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only the two household accounts may read/write the list.
    function allowed() {
      return request.auth != null
        && request.auth.token.email in [
          "user1@removed",
          "user3@removed"
        ];
    }
    match /items/{id} {
      allow read, write: if allowed();
    }
  }
}
