rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only the household accounts may read/write the list.
    // Matched on Firebase Auth UID: it belongs to one specific account and cannot be claimed
    // by someone signing up with the same e-mail address.
    function allowed() {
      return request.auth != null
        && request.auth.uid in [
          "t5dGR98suDbLxc6YooYVJojfnzT2",
          "PiVu94KRDtaFzpNW9rVz04pn7063",
          "gVoryg9A1DZpxgCzVYtV6MOmsHl1"
        ];
    }
    match /items/{id} {
      allow read, write: if allowed();
    }
    // Group names + their order (used by the "Rediger" view)
    match /categories/{id} {
      allow read, write: if allowed();
    }
    // Weekly dinner plan (one doc per weekday)
    match /meals/{id} {
      allow read, write: if allowed();
    }
    // Products bought at Rema 1000 (imported via hent_rema.py), used as suggestions
    match /products/{id} {
      allow read, write: if allowed();
    }
    // Saved dinners (name, ingredients, recipe text)
    match /recipes/{id} {
      allow read, write: if allowed();
    }
  }
}
