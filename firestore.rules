rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only the household accounts may read/write the list.
    // email_verified stops someone from signing up with one of these addresses and a password
    // of their own: Google sign-in is verified, a self-made e-mail/password account is not.
    function allowed() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          "user1@removed",
          "user2@removed"
        ];
    }
    match /items/{id} {
      allow read, write: if allowed();
    }
    // Group names + their order (used by the "Rediger" view)
    match /categories/{id} {
      allow read, write: if allowed();
    }
    // Weekly dinner plan (one doc per weekday)
    match /meals/{id} {
      allow read, write: if allowed();
    }
    // Products bought at Rema 1000 (imported via hent_rema.py), used as suggestions
    match /products/{id} {
      allow read, write: if allowed();
    }
    // Saved dinners (name, ingredients, recipe text)
    match /recipes/{id} {
      allow read, write: if allowed();
    }
  }
}
